# HillGo production environment template.
# Copy to .env on the production server, fill every <...> value,
# then run:  php artisan key:generate
#            php artisan migrate --force && php artisan db:seed --force
#            php artisan config:cache && php artisan route:cache && php artisan event:cache

APP_NAME=HillGo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.<your-domain>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Dhaka

# Comma-separated browser origins allowed to call the API (Admin Panel + Public Web).
# NEVER use *.
CORS_ALLOWED_ORIGINS=https://admin.<your-domain>,https://<your-domain>

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hillgo
DB_USERNAME=<db-user>
DB_PASSWORD=<strong-db-password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# Rotate this before the first production seed, then change the account password after login.
SEED_ADMIN_PASSWORD=<one-time-strong-password>

# SMS provider for OTP delivery (dev falls back to logging OTPs; production must set these).
# SMS_PROVIDER=<provider>
# SMS_API_KEY=<key>
# SMS_SENDER_ID=HillGo

MAIL_MAILER=smtp
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM_ADDRESS="no-reply@<your-domain>"
MAIL_FROM_NAME="${APP_NAME}"
